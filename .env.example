# Runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shorts
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=shorts:

# One public origin behind Caddy; no trailing slash.
# The all-in-one standalone image derives all four from APP_URL instead.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
SHORT_URL_BASE=http://localhost:3000
ADMIN_EMAIL=admin@example.com

# Generate both with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-a-different-random-secret

# Comma-separated exact browser origins. Trust proxy headers only behind Dokploy/a trusted proxy.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Optional WebAuthn/passkeys. Leave PASSKEY_RP_ID empty to disable passkeys safely; restart the API after changing it.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=Shorts
PASSKEY_ORIGIN=
DOCKER_NETWORK=dokploy-network

# Optional image tags used by Compose
CADDY_IMAGE=shorts-caddy:latest
API_IMAGE=shorts-api:latest
WEB_IMAGE=shorts-web:latest
